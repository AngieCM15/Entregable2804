<%- include('partials/header') %>

<form action="/edit/<%= bebida.idlicor %>" id="formulario-editar" autocomplete="off" method="post" enctype="multipart/form-data">
  <div class="card mt-2">
    <div class="card-header"><strong>Editar Bebida</strong></div>
    <div class="card-body">

      <!-- Marca -->
      <div class="row g-2">
        <div class="col-md-6 mb-2">
          <div class="form-floating">
            <select name="marcas" id="marcas" class="form-select" required>
              <option value="" disabled>Seleccione</option>
              <% marcas.forEach(element => { %>
                <option value="<%= element.idmarca %>" <%= bebida.idmarca === element.idmarca ? 'selected' : '' %>>
                  <%= element.marca %>
                </option>
              <% }) %>
            </select>
            <label for="marcas">Marca de la Empresa</label>
          </div>
        </div>
      </div>

      <!-- Nombre, DNI, Cantidad -->
      <div class="row g-2">
        <div class="col-md-4 mb-2">
          <div class="form-floating">
            <input type="text" id="licor" name="licor" class="form-control" value="<%= bebida.nombre %>" required>
            <label for="licor">Nombre del Licor</label>
          </div>
        </div>

        <div class="col-md-4 mb-2">
          <div class="form-floating">
            <input type="text" minlength="8" maxlength="8" pattern="[0-9]+" id="dni" name="dni" class="form-control" value="<%= bebida.dni %>" required>
            <label for="dni">Código</label>
          </div>
        </div>

        <div class="col-md-4 mb-2">
          <div class="form-floating">
            <input type="text" id="cantidad" name="cantidad" class="form-control" value="<%= bebida.cantidad %>" required>
            <label for="cantidad">Cantidad de Producto</label>
          </div>
        </div>
      </div>

      <!-- Condición -->
      <div class="row">
        <div class="col-md-12">
          <div class="form-floating">
            <select name="condicion" id="condicion" class="form-select" required>
              <option value="Seco" <%= bebida.condicion === 'Seco' ? 'selected' : '' %>>Seco</option>
              <option value="Semiseco" <%= bebida.condicion === 'Semiseco' ? 'selected' : '' %>>Semiseco</option>
            </select>
            <label for="condicion">Condición</label>
          </div>
        </div>
      </div>

      <!-- Imagen actual -->
      <% if (bebida.imagen) { %>
        <div class="row mt-3">
          <div class="col-md-12 text-center">
            <p>Imagen actual:</p>
            <img src="/uploads/<%= bebida.imagen %>" alt="Imagen actual" style="max-width: 200px; border-radius: 4px;">
          </div>
        </div>
      <% } %>

      <!-- Nueva imagen -->
      <div class="row g-2 mt-3">
        <div class="col-md-12 mb-2">
          <div class="form-floating">
            <input type="file" name="imagen" id="imagen" class="form-control" accept="image/*">
            <label for="imagen">Subir nueva imagen (opcional)</label>
          </div>
        </div>
      </div>
    </div>

    <div class="card-footer">
      <button type="submit" class="btn btn-sm btn-primary">Actualizar</button>
      <a href="/" class="btn btn-sm btn-secondary">Cancelar</a>
    </div>
  </div>
</form>

<!-- SweetAlert -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
  document.getElementById('formulario-editar').addEventListener('submit', async (event) => {
    event.preventDefault();
    const formData = new FormData(event.target);
    try {
      const response = await fetch(event.target.action, {
        method: 'POST',
        body: formData
      });
      const result = await response.json();
      if (result.success) {
        Swal.fire('Éxito', result.message, 'success').then(() => {
          window.location.href = '/';
        });
      } else {
        Swal.fire('Error', result.message, 'error');
      }
    } catch (err) {
      Swal.fire('Error', 'No se pudo actualizar el licor.', 'error');
    }
  });
</script>
