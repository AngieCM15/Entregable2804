<%- include('partials/header') %>

<div class="container">
  <div class="row">
    <% licores.forEach(licor => { %>
      <div class="col-md-4 mb-4">
        <div class="card h-100 shadow-sm">
          <img src="/uploads/<%= licor.imagen %>" class="card-img-top" alt="Imagen de <%= licor.nombre %>">
          <div class="card-body">
            <h5 class="card-title"><%= licor.marca %></h5>
            <p class="card-text">
              <strong>ID:</strong> <%= licor.idlicor %><br>
              <strong>Código:</strong> <%= licor.dni %><br>
              <strong>Cantidad:</strong> <%= licor.cantidad %><br>
              <strong>Condición:</strong> <%= licor.condicion %>
            </p>
            <div class="d-flex justify-content-between">
              <a href="/edit/<%= licor.idlicor %>" class="btn btn-sm btn-info">Editar</a>
              <a href="/delete/<%= licor.idlicor %>" class="btn btn-sm btn-danger delete">Eliminar</a>
            </div>
          </div>
        </div>
      </div>
    <% }) %>
  </div>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const enlacesEliminar = document.querySelectorAll(".delete");
    enlacesEliminar.forEach(enlace => {
      enlace.addEventListener("click", (event) => {
        event.preventDefault();

        Swal.fire({
          title: '¿Está seguro de eliminar este licor?',
          text: '¡Esta acción no se puede deshacer!',
          icon: 'warning',
          footer: 'SENATI - Ingeniería Software',
          confirmButtonText: 'Eliminar',
          confirmButtonColor: '#c0392b',
          showCancelButton: true,
          cancelButtonText: 'Cancelar',
          cancelButtonColor: '#2980b9'
        }).then((result) => {
          if (result.isConfirmed) {
            window.location.href = event.target.getAttribute("href");
          }
        });
      });
    });
  });
</script>

<%- include('partials/footer') %>
